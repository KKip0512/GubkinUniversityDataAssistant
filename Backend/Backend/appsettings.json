{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=university;Username=readonly_user;Password=readonly_user"
  },

  "Llm": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen2.5-coder:7b",
    "PromptsPath": "Llm/Prompts.yaml",
    "ExamplesPath": "Llm/Examples.yaml",
    "ExamplesCount": 4,
    "EmbeddingModel": "paraphrase-multilingual",
    "TimeoutSeconds": 180,
    "KeepAliveMinutes": 30,
    "ContextSize": 8192
  },

  "Database": {
    "MaxRows": 1000,
    "TimeoutSeconds": 10,
    "MaxSchemaValues": 20
  },

  "Query": {
    "MaxRetries": 2,
    "MaxQuestionLength": 500,
    "MaxConcurrentRequests": 2,
    "QueueLimit": 20
  }
}
